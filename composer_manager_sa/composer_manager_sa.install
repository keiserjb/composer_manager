<?php

/**
 * @file
 * Install hooks for Composer Manager Security Advisories.
 */

/**
 * Implements hook_requirements().
 */
function composer_manager_sa_requirements($phase) {
  if ($phase == 'runtime') {
    $t = get_t();

    $requirements = array();

    $lock_file = composer_manager_lock_file();

    // If the lock file doesn't exist, show a message about rebuilding composer.json.
    if (!$lock_file || !file_exists(backdrop_realpath($lock_file))) {
      $requirements['composer_manager_security_advisories'] = array(
        'title' => $t('Composer library security updates'),
        'value' => $t('Not available'),
        'description' => $t('The composer.lock file has not been created yet. Visit the <a href="@url">Composer Manager configuration page</a> to rebuild composer.json.', array('@url' => url('admin/config/system/composer-manager'))),
        'severity' => REQUIREMENT_INFO,
      );
      return $requirements;
    }

    // Check if the SecurityChecker class is available.
    if (!class_exists('Enlightn\SecurityChecker\SecurityChecker')) {
      $requirements['composer_manager_security_advisories'] = array(
        'title' => $t('Composer library security updates'),
        'value' => $t('Not available'),
        'description' => $t('The enlightn/security-checker library is not installed. Visit the <a href="@url">Composer Manager configuration page</a> to add the dependency and rebuild composer.json.', array('@url' => url('admin/config/system/composer-manager'))),
        'severity' => REQUIREMENT_WARNING,
      );
      return $requirements;
    }

    $vulnerabilities = composer_manager_sa_cache($lock_file);
    if (is_array($vulnerabilities) && empty($vulnerabilities)) {
      $severity = REQUIREMENT_OK;
      $description = $t('There are no known security issues with Composer libraries.');
    }
    elseif ($vulnerabilities === NULL) {
      $severity = REQUIREMENT_WARNING;
      $description = $t('Composer security check is waiting to run on cron.');
    }
    else {
      $severity = REQUIREMENT_ERROR;
      $formatted = composer_manager_sa_formatted($lock_file, $vulnerabilities);
      $description = filter_xss($formatted);
    }
    $vulnerability_count = (is_array($vulnerabilities)) ? count($vulnerabilities) : 0;
    $requirements['composer_manager_security_advisories'] = array(
      'title' => $t('Composer library security updates'),
      'value' => format_plural($vulnerability_count, '@count security advisory.', '@count security advisories.'),
      'description' => $description,
      'severity' => $severity,
    );

    return $requirements;
  }

  return array();
}
